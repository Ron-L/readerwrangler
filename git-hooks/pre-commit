#!/bin/sh
# RW pre-commit chokepoints — run BY GIT on every commit. This file and every check it calls live in git-hooks/,
# saved in the repo (2026-10-15: they used to live in .git/hooks + .claude/hooks, which git never saves).
# One-time setup per copy of the project:  git config core.hooksPath git-hooks
# Deliberate exception (Ron's call only): git commit --no-verify.

# 1. Version stamps: refuses a commit that touches shipped code but forgets to move its version stamp
#    (ORGANIZER_VERSION, MOBILE_VERSION, WORKER_VERSION, the ?v= cache-busters). (git-hooks/version-guard.py)
python git-hooks/version-guard.py || exit 1

# 2. Undefined names (7.18.0-alpha.55): refuses app code that references a name nothing defines — the bug class a
#    syntax check can't see (a declaration swallowed into a comment crashed the book details window). Also refuses an
#    inline <script> in readerwrangler.html that doesn't parse. Runs when any .js or .html file is staged.
#    (git-hooks/check-names.js; needs `npm i --no-save @babel/core @babel/preset-react`)
if git diff --cached --name-only --diff-filter=ACM | grep -qE '\.(js|html)$'; then
    node git-hooks/check-names.js || exit 1
fi

# 3. Numbers the app and the relay must agree on (7.23.0): refuses a commit where relay-client.js and
#    relay/relay-worker.js disagree on the 90-day upload life, "keep 2 copies", the unfinished-copy grace, or how the
#    time is read out of an id — the worker's nightly cleanup deletes by those rules. (git-hooks/check-shared-numbers.js)
if git diff --cached --name-only --diff-filter=ACM | grep -qE '^(relay-client\.js|relay/relay-worker\.js)$'; then
    node git-hooks/check-shared-numbers.js || exit 1
fi

# 5. Private values (2026-10-31): refuses added lines holding a value from the private secrets note, and Cloud Sync
#    credentials by their shape - a .json backup (or a demo file made from one) with relay.channelId + passphrase, a
#    bookmarklet pasted as text, the Copy text's passphrase. Never prints a value. Runs on every commit; the commit
#    MESSAGE gets the same check from git-hooks/commit-msg. (git-hooks/check-private.py → private_values.py)
#    Earned: the organized demo library carried a credential pair publicly from 2026-07-03 to 2026-10-31.
python git-hooks/check-private.py || exit 1

# 4. TODO.md's table of contents (2026-10-14): refuses a staged TODO.md whose table doesn't match its headers — the
#    VS Code extension rebuilds it only on a VS Code save, so edits made any other way leave it stale. Also refuses a
#    task without its ID line, or a repeated ID (2026-10-21 — tools/backlog_report.py follows tasks by them).
#    Checks the STAGED copy. (git-hooks/check-toc.js)
if git diff --cached --name-only --diff-filter=ACM | grep -qx 'TODO.md'; then
    git show :TODO.md | node git-hooks/check-toc.js - TODO.md || exit 1
fi

# 6. Every staged script parses (2026-11-04, from the utilities project): refuses a staged .js / .mjs / .py that
#    doesn't parse — the fetchers, the bookmarklet menu, the relay worker, reset.js, the tests and every Python file,
#    which the name check never covered. Checks the STAGED copy; JavaScript through Babel (scripts, JSX and modules
#    alike). Tested by test/test_check_parse.py. (git-hooks/check-parse.py → parse-js.js)
if git diff --cached --name-only --diff-filter=ACM | grep -qE '\.(js|mjs|py)$'; then
    python git-hooks/check-parse.py || exit 1
fi

# 7. Tier-1 tests for what changed (2026-11-04, docs/design/TESTING.md): runs the function tests whose covers: lines
#    name a changed file (or that changed themselves) — the regression library, on every commit, automatically. Silent
#    when no test covers the change. Screen tests (tier 2) run before each alpha; relay tests (tier 3) never here.
#    (tools/run_tests.py; its own tests: test/test_run_tests.py)
python tools/run_tests.py --changed --tier 1 --quiet || exit 1

# 8. The logging rules + the support table (2026-11-07, docs/design/LOGGING.md §6): when an app script at the repo root
#    or the table is staged, every rwLog.log(…) call is checked — a known level; code AREA or AREA-NN from logger.js's
#    areas; warning and above numbered; each numbered code at ONE call — and docs/design/MESSAGE-CODES.md must match what
#    the code says (refused with "run py tools/message_codes.py" if not). Checks the STAGED copies.
#    (tools/message_codes.py; its tests: test/test_message_codes.py)
if git diff --cached --name-only --diff-filter=ACMD | grep -qE '^[^/]+\.js$|^docs/design/MESSAGE-CODES\.md$'; then
    python tools/message_codes.py --check || exit 1
fi
