#!/usr/bin/env python
"""commit-msg - the checks that need the commit MESSAGE. Run by git (core.hooksPath git-hooks); bypass is Ron's call only.
  1. Refuse a message holding a private value or a Cloud Sync credential (commit messages are public too) —
     private_values.py.
  2. Refuse a commit that removes a TODO task without saying why — a ✅, a "merged" list, or `done <id>` /
     `dropped <id>` in the message (2026-11-10: a task was lost by accident in a big TODO edit) —
     check-removed-tasks.py."""
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from private_values import check_lines  # noqa: E402

SCISSORS = "# ------------------------ >8"   # commit --verbose: the diff below it is not part of the message


def message_lines(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        for n, ln in enumerate(f, 1):
            if ln.startswith(SCISSORS):
                break
            if not ln.startswith("#"):
                yield f"message line {n}", ln


if __name__ == "__main__":
    private = check_lines("commit-msg", "these message lines", message_lines(sys.argv[1]))
    removed = subprocess.run([sys.executable, os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                                           "check-removed-tasks.py"), sys.argv[1]]).returncode
    sys.exit(private or removed)
