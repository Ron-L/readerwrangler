#!/usr/bin/env python
"""commit-msg - refuse a commit whose MESSAGE holds a private value or a Cloud Sync credential (commit messages are
public too). The check itself: private_values.py. Run by git (core.hooksPath git-hooks); bypass is Ron's call only."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from private_values import check_lines  # noqa: E402

SCISSORS = "# ------------------------ >8"   # commit --verbose: the diff below it is not part of the message


def message_lines(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        for n, ln in enumerate(f, 1):
            if ln.startswith(SCISSORS):
                break
            if not ln.startswith("#"):
                yield f"message line {n}", ln


if __name__ == "__main__":
    sys.exit(check_lines("commit-msg", "these message lines", message_lines(sys.argv[1])))
