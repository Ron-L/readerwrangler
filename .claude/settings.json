{
  "permissions": {
    "allow": [
      "Read(//c/Users/Ron/Projects/ReaderWrangler/**)",
      "Edit(//c/Users/Ron/Projects/ReaderWrangler/**)",
      "Read(//c/Users/Ron/.claude/projects/c--Users-Ron-Projects-ReaderWrangler/memory/**)",
      "Edit(//c/Users/Ron/.claude/projects/c--Users-Ron-Projects-ReaderWrangler/memory/**)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git branch:*)", "Bash(git checkout:*)", "Bash(git switch:*)", "Bash(git add:*)",
      "Bash(git commit:*)", "Bash(git merge:*)", "Bash(git cherry-pick:*)", "Bash(git tag:*)",
      "Bash(git fetch:*)", "Bash(git mv:*)", "Bash(git rm:*)", "Bash(git stash:*)",
      "Bash(git rev-parse:*)", "Bash(git merge-base:*)", "Bash(git ls-files:*)", "Bash(git check-ignore:*)",
      "Bash(git push dev:*)",
      "Bash(py tools/build.py:*)", "Bash(py tools/run_tests.py:*)", "Bash(py tools/message_codes.py:*)",
      "Bash(py tools/backlog_report.py:*)", "Bash(py tools/time_load.py:*)",
      "Bash(python test/:*)", "Bash(python tools/:*)", "Bash(python git-hooks/:*)",
      "Bash(.venv/Scripts/python test/:*)", "Bash(.venv/Scripts/python tools/:*)",
      "Bash(node test/:*)", "Bash(node git-hooks/:*)",
      "Bash(npm ci)",
      "Bash(cd:*)", "Bash(ls:*)", "Bash(wc:*)", "Bash(grep:*)", "Bash(head:*)", "Bash(tail:*)",
      "Bash(cat:*)", "Bash(sed -n:*)", "Bash(echo:*)", "Bash(export PYTHONIOENCODING=utf-8)",
      "Bash(curl -s -m 10 \"https://readerwrangler.com/:*)",
      "Bash(curl -s -m 10 \"https://ron-l.github.io/readerwranglerdev/:*)"
    ],
    "ask": [
      "Bash(git push prod:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npx wrangler secret:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)",
      "Bash(git push dev --force:*)", "Bash(git push dev -f:*)", "Bash(git push dev +:*)",
      "Bash(git push prod --force:*)", "Bash(git push prod -f:*)", "Bash(git push prod +:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate-check.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate-reset.py\""
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate-batch-end.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/relay-check.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/survey-check.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate-reset.py\""
          }
        ]
      }
    ]
  }
}
